-            if ((!from_live || incoming || slot_source >= 0) && !pin_sibling && !park_current(incoming ? incoming->bytes() : 0)) {
+            // STRATA_PARK_SKIP_SAME_PREFIX=1 (opt-in, local patch): a request that resumes from a checkpoint the live
+            // session also starts with continues the SAME conversation - typically the client sent the last answer
+            // back without the model's thinking, so the prompt leaves the live branch at that assistant turn.  The
+            // live branch past the checkpoint (the old thinking and answer) is never asked for again, so parking it
+            // costs 0.3-1.4 s on this request's path for nothing: skip it, as with the conversation cache off.  A
+            // request for another conversation (a parked one, a slot, or no shared prefix) still parks as before.
+            static const bool skip_same_prefix = [] {
+                const char* e = std::getenv("STRATA_PARK_SKIP_SAME_PREFIX");
+                return e != nullptr && e[0] == '1';
+            }();
+            bool same_prefix = false;
+            if (skip_same_prefix && !from_live && !incoming && slot_source < 0 && resume > 0 && live_ok &&
+                (int64_t) live.size() >= resume && imgs_below(live_imgs, resume) == imgs_below(req_imgs, resume)) {
+                same_prefix = true;
+                for (int64_t i = 0; i < resume; ++i)
+                    if ((int32_t) ids[(size_t) i] != live[(size_t) i]) { same_prefix = false; break; }
+                if (same_prefix)
+                    std::fprintf(stderr, "strata serve: conversation cache: not parking the live branch (this request "
+                                         "continues it from token %lld)\n", (long long) resume);
+            }
+            if ((!from_live || incoming || slot_source >= 0) && !pin_sibling && !same_prefix &&
+                !park_current(incoming ? incoming->bytes() : 0)) {
                 std::printf("ERR %s\n", err.c_str());
                 return 1;
             }
