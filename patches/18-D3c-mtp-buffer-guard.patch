Patch D3c (ours): skip the MTP target-hidden-state buffer when it does not exist.
For   : vLLM a5a30471 + iIIusi0n PLE-SSD + 2dameneko 56e1347 + patches 01-17 of this repository.
Why   : with a drafter other than MTP (DFlash2) get_mtp_target_hidden_states() returns None, and slicing it killed
        a worker while the engine started. The runner now keeps the regular hidden states in that case.
Effect: none with MTP (the buffer exists); needed for "method": "dflash".
Apply : git apply -p1 --check <patch> && git apply -p1 <patch>   (run in the tree root)
Applied inline on the night-4 tree on 2026-10-20; this diff is taken from the pre-D3c backup.

--- a/vllm/v1/worker/gpu/model_runner.py
+++ b/vllm/v1/worker/gpu/model_runner.py
@@ -888,7 +888,9 @@
             spec_hidden_states = hidden_states
             if hasattr(self.model, "get_mtp_target_hidden_states"):
                 pre_hc_hidden_states = self.model.get_mtp_target_hidden_states()
-                spec_hidden_states = pre_hc_hidden_states[: hidden_states.shape[0]]  # type: ignore[union-attr]
+                # Asgard patch D3c: the MTP buffer does not exist with other drafters (DFlash2)
+                if pre_hc_hidden_states is not None:
+                    spec_hidden_states = pre_hc_hidden_states[: hidden_states.shape[0]]  # type: ignore[union-attr]
             if isinstance(self.sampler, GPUWatermarkSampler):
                 self.speculator.prepare_watermarking(
                     self.sampler._get_contexts(input_batch.idx_mapping),
@@ -2231,7 +2233,8 @@
             spec_hidden_states = draft_hidden_states
             if hasattr(self.model, "get_mtp_target_hidden_states"):
                 pre_hc_hidden_states = self.model.get_mtp_target_hidden_states()
-                spec_hidden_states = pre_hc_hidden_states[: draft_hidden_states.size(0)]
+                if pre_hc_hidden_states is not None:  # Asgard patch D3c
+                    spec_hidden_states = pre_hc_hidden_states[: draft_hidden_states.size(0)]
             if isinstance(self.sampler, GPUWatermarkSampler):
                 self.speculator.prepare_watermarking(
                     self.sampler._get_contexts(input_batch.idx_mapping),
